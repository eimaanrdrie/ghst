# Runtime
ENVIRONMENT=development
DEMO_MODE=true
FAIL_CLOSED=true
LOG_LEVEL=INFO

# API and browser clients
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,chrome-extension://__EXTENSION_ID__
# For a Vercel-hosted frontend, replace CORS_ORIGINS with your deployed domain as well.
# Example:
# CORS_ORIGINS=http://localhost:3000,https://your-project.vercel.app,chrome-extension://__EXTENSION_ID__

# Local database: development Docker uses PostgreSQL; SQLite is the offline fallback.
DATABASE_URL=postgresql+psycopg://ghst:ghst@postgres:5432/ghst
# DATABASE_URL=sqlite:///./ghst_demo.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=300

# Production database: paste the exact Supabase Session pooler URI from
# Dashboard > Connect, change postgres:// to postgresql+psycopg://, URL-encode
# special password characters, and retain sslmode=require. Never prefix PUBLIC_.
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Replace every value below outside disposable local development.
JWT_SECRET=change-me-with-at-least-32-random-characters
PROMPT_HMAC_KEY=change-me-with-at-least-32-random-characters
REVIEW_ENCRYPTION_KEY=change-me-with-a-base64-32-byte-aes-key
GRANT_ED25519_PRIVATE_KEY=
GRANT_ED25519_PUBLIC_KEY=

# Governance controls
SUPPORTED_AI_ORIGINS=http://localhost:3000/ai-sandbox,https://chatgpt.com,https://chat.openai.com
APPROVED_DESTINATION_ORIGIN=http://localhost:3000/ai-sandbox
APPROVED_DESTINATION_SERVICE=GHST Sandbox AI
APPROVED_DESTINATION_TENANT=demo-tenant
APPROVED_MODEL_CLASS=mock-approved-model
MAX_PROMPT_CHARS=12000
MAX_PDF_BYTES=5242880
MAX_PDF_PAGES=25
PDF_PARSE_TIMEOUT_SECONDS=20
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_COMMAND=tesseract
PDF_RENDERER_COMMAND=pdftoppm
REVIEW_TTL_SECONDS=900
CLEARANCE_TTL_SECONDS=60
PRECEDENT_VALID_DAYS=90
ACE_SIMILARITY_THRESHOLD=0.72
LOCAL_MODEL_CONFIDENCE_THRESHOLD=0.78
SECOND_REVIEWER_RISK_THRESHOLD=0.60
SESSION_RISK_TTL_SECONDS=1800

# Local model. DEMO_MODE=true uses the transparent deterministic adapter.
LOCAL_MODEL=qwen3.5:9b
LOCAL_MODEL_FALLBACK=qwen3.5:4b
OLLAMA_URL=http://ollama:11434

# Optional approved downstream provider. Mock mode is the default.
DOWNSTREAM_MODE=mock
DOWNSTREAM_PROVIDER=openai_compatible
DOWNSTREAM_BASE_URL=
DOWNSTREAM_API_KEY=
DOWNSTREAM_CHAT_PATH=/v1/chat/completions
DOWNSTREAM_MODEL=
DOWNSTREAM_CA_BUNDLE=
DOWNSTREAM_TIMEOUT_SECONDS=20
